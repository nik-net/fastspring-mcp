# FastSpring API credentials (required)
FS_API_USERNAME=your_fastspring_username
FS_API_PASSWORD=your_fastspring_password

# FastSpring Classic API company ID (required for order reference lookups)
# Find your company ID in the FastSpring app URL: https://app.fastspring.com/company/{company_id}/...
# Used by: GET /company/{FS_COMPANY_ID}/order/{reference}
# Example: example-company
FS_COMPANY_ID=your_company_id

# ── Legacy Classic platform credentials (optional — dual-platform support) ──
# Set these when your account runs both the modern SBL platform and the legacy
# Classic platform. When configured, order reference lookups automatically retry
# with these credentials if the primary credentials are denied or the order is
# not found (e.g. VI8170706-* orders only accessible via the Classic account).
#
# Obtain from: FastSpring Classic dashboard → Settings → API Access
# FS_LEGACY_API_USERNAME=legacy_username_or_email
# FS_LEGACY_API_PASSWORD=legacy_password
# FS_LEGACY_COMPANY_ID=legacy_company_id   # only needed if different from FS_COMPANY_ID

# Enable request/response debug logging (also sets log level to debug)
FS_DEBUG=false

# Logging: level (debug | info | warn | error | fatal), dir for daily log files. Default is debug so API request/response are logged.
FS_LOG_LEVEL=debug
FS_LOG_DIR=logs

# ── Integration test fixtures (scripts/integration-test-api.mjs) ──────────────
# Required to run integration tests against the real FastSpring API.
# Use values from your own FastSpring account — never commit real customer data.
# TEST_ORDER_REFERENCE=YOUR-ORDER-REFERENCE-HERE
# TEST_SUBSCRIPTION_ID=your-subscription-id-here
# TEST_CUSTOMER_EMAIL=customer@example.com

# ── Transport mode ────────────────────────────────────────────────────────────
# MCP_TRANSPORT controls which transport the server uses.
# Options: stdio (default) | http
# MCP_TRANSPORT=stdio

# ── Streamable HTTP transport options (only used when MCP_TRANSPORT=http) ────
# Port to listen on (default: 3000)
# MCP_HTTP_PORT=3000

# Host/interface to bind to (default: 0.0.0.0  →  all interfaces)
# MCP_HTTP_HOST=0.0.0.0

# URL path for the MCP endpoint (default: /mcp)
# MCP_HTTP_PATH=/mcp

# Set to true to enable stateless mode (new server per request, no session IDs)
# Suitable for serverless / ephemeral deployments. Default: false (stateful)
# MCP_HTTP_STATELESS=false

# ── HTTP transport authentication (only used when MCP_TRANSPORT=http) ────────
# Set to true to require Bearer token authentication on all MCP endpoints.
# /health is always exempt (required for Docker health probes).
# Default: false (no auth — safe for local/trusted networks only)
# MCP_AUTH_ENABLED=false

# Comma-separated list of valid API keys. Any single key grants full access.
# Required when MCP_AUTH_ENABLED=true. Ignored when auth is disabled.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_API_KEYS=your-secret-key-here,optional-second-key
